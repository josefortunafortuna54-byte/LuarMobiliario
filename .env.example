# Luar Company Imobiliária - Variáveis de Ambiente
# Copie este ficheiro para .env dentro de luar_company/ e preencha os valores
# NUNCA faça commit do ficheiro .env com valores reais
#
# NOTA: o .env NÃO é empacotado como asset do app. Os valores são injetados
# em tempo de build via --dart-define (ver README e scripts/build_*.sh).

# Supabase (obrigatório)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Firebase Cloud Messaging (opcional - necessário para notificações push)
FCM_SENDER_ID=your-sender-id
FCM_PROJECT_ID=your-project-id
FCM_API_KEY=
FCM_APP_ID=
