# Supabase (obrigatorio)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Firebase Cloud Messaging (opcional - necessario para notificacoes push)
# FCM_API_KEY e a chave de API (Web/Android) do projeto Firebase.
# FCM_APP_ID e opcional; se vazio, e derivado do FCM_SENDER_ID.
FCM_SENDER_ID=
FCM_PROJECT_ID=
FCM_API_KEY=
FCM_APP_ID=

# Edge function send-notification (definir no Supabase, nao no app):
#   supabase secrets set FCM_SERVER_KEY=<chave-servidor-legada-do-firebase>